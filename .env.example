# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google accounts that get the admin (teacher) role, comma-separated
ADMIN_EMAILS=you@gmail.com

# Public URL used in invite emails (optional on Vercel; it defaults to the production domain)
APP_URL=

# Email invites over SMTP. For Gmail: your address + an App Password
# (Google Account → Security → 2-Step Verification → App passwords). Leave empty to skip emails.
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mock Test Simulator <you@gmail.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Database: added automatically when Upstash Redis is connected in Vercel → Storage.
# Leave empty locally to use a file-backed dev store in .data/
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local only: shows a "sign in as any email" form so you can try both roles without Google keys.
# Ignored in production builds.
AUTH_DEV_LOGIN=
